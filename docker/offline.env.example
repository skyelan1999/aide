# Offline bundle settings. Use absolute paths when selecting existing directories.
AIDE_PORT=8097
AIDE_WORKSPACE=./workspace
AIDE_CONTEXT=./context
# AIDE_LOCAL_ROOT=/absolute/path/to/projects
# Configure a model in the browser, or point to a model reachable from the target machine.
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=
AI_API_KEY=
AIDE_WEBSEARCH_URL=

# Optional built-in assistant memory engine (restart after changing).
AIDE_ASSISTANT_ENGINE=builtin
AIDE_ASSISTANT_TIMEZONE=UTC
# Optional loopback-only embedding JSON; leave empty for lexical retrieval.
# Keep any embedding token private; never put real values in source control.
AIDE_MIXSOUL_LOCAL_EMBEDDING=
