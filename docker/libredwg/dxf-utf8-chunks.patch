+/* DXF group 3 continuation chunks must not divide a UTF-8 code point. */
+static int
+dxf_utf8_chunk (const char *text, long length)
+{
+  int count = length > 250 ? 250 : (int)length;
+  if (length > count)
+    while (count > 0 && (((unsigned char)text[count] & 0xc0) == 0x80))
+      count--;
+  if (length > count)
+    {
+      int i;
+      for (i = count > 7 ? count - 7 : 0; i < count; i++)
+        if (text[i] == '\\' && i + 2 < length && text[i + 2] == '+'
+            && ((text[i + 1] == 'U' && i + 7 > count && length - i >= 7)
+                || (text[i + 1] == 'M' && i + 8 > count && length - i >= 8)))
+          { count = i; break; }
+    }
+  return count > 0 ? count : 250;
+}
