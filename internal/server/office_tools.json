[
  {
    "type": "function",
    "function": {
      "name": "office_document_search",
      "description": "Search extracted document text or retrieve source excerpts. Reuse the same query, mode, source and path with nextCursor. Cite returned locators; no OCR.",
      "parameters": {
        "type": "object",
        "required": [
          "query",
          "mode"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "original",
              "rag"
            ]
          },
          "source": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "office_document_read",
      "description": "Read saved DOCX, XLSX or PPTX blocks with IDs and file hash. Use nextOffset for later blocks. The source must be visible to AI.",
      "parameters": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "office_document_edit",
      "description": "Replace matching DOCX, XLSX or PPTX blocks using their latest IDs, exact expectedText and file hash. Writes are atomic and reject stale versions.",
      "parameters": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "changes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "expectedText",
                "newText"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "expectedText": {
                  "type": "string"
                },
                "newText": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "office_create",
      "description": "Create DOCX/XLSX/PPTX in bound system-docs or workspace without overwriting. DOCX blocks use {type:heading|paragraph|table,text,level?,rows?}; XLSX sheets use {name,rows}; PPTX slides use {title,body}. Read back the result.",
      "parameters": {
        "type": "object",
        "required": [
          "path",
          "format",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "docx",
              "xlsx",
              "pptx"
            ]
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "sheets": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "slides": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "office_comments",
      "description": "Read embedded DOCX comments and their exact anchored text. Require anchorValid before using the anchor.",
      "parameters": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "office_comment_edit",
      "description": "Replace the exact text anchored by a DOCX comment, preserving the comment for review.",
      "parameters": {
        "type": "object",
        "required": [
          "path",
          "id",
          "expectedText",
          "newText"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          },
          "expectedText": {
            "type": "string"
          },
          "newText": {
            "type": "string"
          }
        }
      }
    }
  }
]
