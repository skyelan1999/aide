{
  "version": 1,
  "sections": [
    {
      "id": "appearance",
      "title": "外观",
      "description": "专业、舒适、经典三种配色，支持浅色、深色和跟随系统。",
      "controls": [
        {
          "id": "theme",
          "type": "segmented",
          "label": "专业",
          "palette": "blue",
          "options": [
            {
              "value": "light",
              "label": "浅色"
            },
            {
              "value": "dark",
              "label": "深色"
            },
            {
              "value": "system",
              "label": "跟随系统"
            }
          ]
        },
        {
          "id": "theme",
          "type": "segmented",
          "label": "舒适",
          "palette": "comfort",
          "options": [
            {
              "value": "light",
              "label": "浅色"
            },
            {
              "value": "dark",
              "label": "深色"
            },
            {
              "value": "system",
              "label": "跟随系统"
            }
          ]
        },
        {
          "id": "theme",
          "type": "segmented",
          "label": "经典",
          "palette": "green",
          "options": [
            {
              "value": "light",
              "label": "浅色"
            },
            {
              "value": "dark",
              "label": "深色"
            },
            {
              "value": "system",
              "label": "跟随系统"
            }
          ]
        },
        {
          "id": "motion",
          "type": "segmented",
          "label": "动效强度",
          "options": [
            {
              "value": "system",
              "label": "跟随系统"
            },
            {
              "value": "full",
              "label": "轻盈动效"
            },
            {
              "value": "reduced",
              "label": "减少动态效果"
            }
          ]
        },
        {
          "id": "startupAnimation",
          "type": "segmented",
          "label": "启动动画",
          "options": [
            {
              "value": "on",
              "label": "开启"
            },
            {
              "value": "off",
              "label": "关闭"
            }
          ]
        },
        {
          "id": "experience-preview",
          "type": "experience-preview",
          "label": "重播启动动画"
        }
      ]
    },
    {
      "id": "language",
      "title": "语言",
      "controls": [
        {
          "type": "language",
          "id": "language"
        }
      ]
    },
    {
      "id": "file-rendering",
      "title": "文件查看与渲染",
      "description": "勾选后立即生效，自动保存到当前浏览器；同源标签页同步。默认预览选项在下次打开文件时应用。文件内容仍需点击保存。",
      "controls": [
        {
          "id": "fileLineNumbers",
          "type": "checkbox",
          "label": "显示行号",
          "description": "所有代码和 TXT 等文本文件，编辑与只读视图均支持。"
        },
        {
          "id": "fileSyntaxHighlight",
          "type": "checkbox",
          "label": "代码语法高亮",
          "description": "已识别语言显示语法颜色，其他格式保留普通文本。"
        },
        {
          "id": "fileMarkdownPreview",
          "type": "checkbox",
          "label": "Markdown 默认渲染预览",
          "description": "取消勾选后默认打开 Markdown 源文。"
        },
        {
          "id": "fileMarkdownEditing",
          "type": "segmented",
          "label": "Markdown 编辑模式",
          "options": [
            {
              "value": "split",
              "label": "左右对比"
            },
            {
              "value": "text",
              "label": "纯文本"
            }
          ]
        },
        {
          "id": "fileMarkdownOutline",
          "type": "checkbox",
          "label": "Markdown 标题目录",
          "description": "预览中显示标题导航。"
        },
        {
          "id": "fileMarkdownMedia",
          "type": "checkbox",
          "label": "Markdown 插入工具栏",
          "description": "可写 Markdown 显示文件、图片和 draw.io 插入入口。"
        },
        {
          "id": "fileCsvPreview",
          "type": "checkbox",
          "label": "CSV / TSV 默认表格预览",
          "description": "取消勾选后默认打开原文，仍可手动切换表格。"
        },
        {
          "id": "markdownHistory",
          "type": "markdown-history",
          "label": "Markdown 历史版本追踪"
        },
        {
          "id": "workRecovery",
          "type": "checkbox",
          "label": "工作现场与本地草稿恢复",
          "description": "在当前浏览器保存会话草稿、目录和编辑恢复记录；服务器保存状态单独显示。"
        },
        {
          "id": "recovery-storage",
          "type": "recovery-storage",
          "label": "本地恢复存储"
        }
      ]
    },
    {
      "id": "knowledge-index",
      "title": "知识索引",
      "controls": [
        {
          "id": "knowledge-index-policy",
          "type": "knowledge-index-policy",
          "label": "索引预算与优先路径"
        },
        {
          "id": "knowledge-embedding-policy",
          "type": "knowledge-embedding-policy",
          "label": "向量混合检索"
        }
      ]
    },
    {
      "id": "model",
      "title": "模型参数",
      "description": "管理模型调用参数配置（Profile）",
      "children": [
        {
          "id": "model-profiles",
          "title": "参数配置",
          "controls": [
            {
              "id": "model-profiles",
              "type": "profiles-manager",
              "label": "参数配置"
            }
          ]
        }
      ]
    },
    {
      "id": "execution-policy",
      "title": "执行策略",
      "description": "配置执行循环、时间预算和提示词，无需重新编译",
      "controls": [
        {
          "id": "execution-policy",
          "type": "execution-policy",
          "label": "执行策略"
        },
        {
          "id": "workspace-policy",
          "type": "workspace-policy",
          "label": "当前工作区执行策略覆盖"
        },
        {
          "id": "harness-config",
          "type": "harness-config",
          "label": "扩展机制配置"
        },
        {
          "id": "managed-worktrees",
          "type": "managed-worktrees",
          "label": "任务工作树"
        }
      ]
    },
    {
      "id": "permissions",
      "title": "权限管理",
      "description": "控制 AI 在工作区里能自动做什么",
      "controls": [
        {
          "id": "sandboxMode",
          "type": "segmented",
          "label": "沙箱模式",
          "options": [
            {
              "value": "read-only",
              "label": "只读"
            },
            {
              "value": "workspace-write",
              "label": "工作区可写"
            },
            {
              "value": "danger-full-access",
              "label": "完全访问"
            }
          ]
        },
        {
          "id": "permission-manager",
          "type": "permission-manager",
          "label": "工具权限"
        }
      ]
    },
    {
      "id": "capabilities",
      "title": "连接与能力",
      "description": "分别观察配置、工具登记和具体检查；检查结果有时间与范围，不代替完整验收。",
      "controls": [
        {
          "id": "capabilities",
          "type": "capabilities",
          "label": "连接与插件能力仪表"
        }
      ]
    },
    {
      "id": "persona",
      "title": "aide 性格",
      "description": "aide 性格系统，仅作用于基本聊天。可自定义性格提示词，系统会随使用自动精简演化以节约 token。",
      "controls": [
        {
          "id": "personalityAide",
          "type": "personality",
          "persona": "aide",
          "label": "aide 性格系统"
        }
      ]
    },
    {
      "id": "voice",
      "title": "语音助理",
      "description": "普通会话的麦克风会过滤背景声并把指令交给当前会话；小秘会话中麦克风先转写到输入框，编辑后再发送。",
      "controls": [
        {
          "id": "voiceAssistantName",
          "type": "voice-name",
          "label": "助理名称"
        },
        {
          "id": "xiaomi-model",
          "type": "xiaomi-model",
          "label": "小秘模型"
        },
        {
          "id": "personalityXiaomi",
          "type": "personality",
          "persona": "xiaomi",
          "label": "助理性格系统"
        },
        {
          "id": "voiceInputSource",
          "type": "voice-input-source",
          "label": "麦克风输入源"
        },
        {
          "id": "voiceDispatch",
          "type": "voice-dispatch",
          "label": "发送调度"
        },
        {
          "id": "voiceReply",
          "type": "voice-reply",
          "label": "语音回复"
        },
        {
          "id": "ttsEngine",
          "type": "tts-engine",
          "label": "语音引擎"
        },
        {
          "id": "voiceClone",
          "type": "voice-clone",
          "label": "个性化音色（声音克隆）"
        }
      ]
    },
    {
      "id": "virtual-avatars",
      "title": "虚拟形象",
      "description": "aide 与小秘共用一个虚拟形象，统一管理素材包、显示位置与启用状态。导入素材仅保存在当前浏览器。",
      "controls": [
        {
          "id": "virtual-avatars",
          "type": "virtual-avatars",
          "label": "虚拟形象"
        }
      ]
    },
    {
      "id": "accessibility",
      "title": "无障碍",
      "controls": [
        {
          "id": "accessibilityAutoRead",
          "type": "accessibility-read",
          "label": "输出完成后自动朗读"
        },
        {
          "id": "debug-access",
          "type": "debug-access",
          "label": "允许外部 AI 接入调试"
        }
      ]
    },
    {
      "id": "stats",
      "title": "消耗统计",
      "description": "模型调用 Token 消耗与费用趋势",
      "controls": [
        {
          "id": "token-stats",
          "type": "token-stats",
          "label": "Token 消耗"
        }
      ]
    },
    {
      "id": "sessions-data",
      "title": "归档",
      "description": "归档会话管理与会话数据全部导出",
      "controls": [
        {
          "id": "sessions-manage",
          "type": "sessions-manage",
          "label": "会话数据"
        }
      ]
    },
    {
      "id": "backup",
      "title": "配置备份",
      "controls": [
        {
          "id": "config-backup",
          "type": "config-backup",
          "label": "配置导出与导入"
        }
      ]
    },
    {
      "id": "account",
      "title": "账户",
      "description": "设置用户名与锁屏密码；锁屏密码同时作为小秘对话历史的加密密钥。不设密码则不锁屏。",
      "controls": [
        {
          "id": "account",
          "type": "account",
          "label": "账户与锁屏"
        }
      ]
    },
    {
      "id": "system-logs",
      "title": "系统日志",
      "description": "查看近期运行日志，按级别筛选并下载 JSONL 文件以辅助问题分析。现有未结构化日志的级别根据内容推断；敏感凭据会在记录和导出前脱敏。",
      "controls": [
        {
          "id": "system-logs",
          "type": "system-logs",
          "label": "运行日志"
        }
      ]
    },
    {
      "id": "software-updates",
      "title": "软件升级",
      "controls": [
        {
          "id": "software-updates",
          "type": "software-updates",
          "label": "检查软件更新"
        }
      ]
    },
    {
      "id": "about",
      "title": "关于",
      "controls": [
        {
          "id": "about-project",
          "type": "about-project",
          "repository": "https://github.com/skyelan1999/aide"
        }
      ]
    },
    {
      "id": "danger",
      "title": "恢复出厂设置",
      "controls": [
        {
          "id": "factory-reset",
          "type": "factory-reset",
          "label": "恢复出厂设置"
        }
      ]
    }
  ]
}
