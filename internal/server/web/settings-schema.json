      "controls": [
        {
          "id": "theme",
          "type": "segmented",
          "label": "主题颜色",
          "options": [
            { "value": "light", "label": "明" },
            { "value": "dark", "label": "暗" },
            { "value": "system", "label": "跟随系统" }
          ]
        }
      ]
    },
    {
      "id": "token-usage",
      "title": "消耗统计",
