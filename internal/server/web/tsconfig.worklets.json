{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2022"],
    "module": "ES2020",
    "moduleResolution": "node",
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "declaration": false,
    "removeComments": false,
    "newLine": "lf"
  },
  "include": ["assistant-pcm-worklet.ts", "voip-pcm-worklet.ts", "audio-worklet.d.ts"]
}
