+/* Checked Emscripten allocation boundary. Native builds retain normal
+ * failure/cleanup semantics so sanitizer fault-injection can exercise them. */
+#ifdef __EMSCRIPTEN__
+extern void aideAllocationCheck(size_t bytes, void *pointer, int after);
+static void *aide_malloc(size_t n) {
+    void *p; aideAllocationCheck(n, NULL, 0); p = malloc(n);
+    aideAllocationCheck(n, p, 1); return p;
+}
+static void *aide_calloc(size_t count, size_t size) {
+    void *p;
+    if (size && count > (size_t)-1 / size) { aideAllocationCheck((size_t)-1, NULL, 0); return NULL; }
+    aideAllocationCheck(count * size, NULL, 0); p = calloc(count, size);
+    aideAllocationCheck(count * size, p, 1); return p;
+}
+static void *aide_realloc(void *old, size_t n) {
+    void *p; aideAllocationCheck(n, NULL, 0); p = realloc(old, n);
+    aideAllocationCheck(n, p, 1); return p;
+}
+#if defined(OPJ_HAVE_POSIX_MEMALIGN)
+static int aide_posix_memalign(void **p, size_t alignment, size_t n) {
+    int error; aideAllocationCheck(n, NULL, 0);
+    error = posix_memalign(p, alignment, n);
+    aideAllocationCheck(n, error ? NULL : *p, 1); return error;
+}
+#define posix_memalign aide_posix_memalign
+#endif
+#if defined(OPJ_HAVE_MEMALIGN)
+static void *aide_memalign(size_t alignment, size_t n) {
+    void *p; aideAllocationCheck(n, NULL, 0); p = memalign(alignment, n);
+    aideAllocationCheck(n, p, 1); return p;
+}
+#define memalign aide_memalign
+#endif
+#define malloc aide_malloc
+#define calloc aide_calloc
