# Preserve official vendored bytes, including license comment line endings.
internal/server/web/vendor/markdown-export/jspdf.umd.min.js whitespace=-blank-at-eol
# Preserve original OCCT license bytes and generated STEP exchange formatting.
scripts/cad/licenses/OCCT-LGPL-2.1.txt whitespace=-blank-at-eol
scripts/fixtures/cad/fidelity.step whitespace=-blank-at-eol

# Linux container entry points must survive Windows core.autocrlf checkouts.
*.sh text eol=lf
*.command text eol=lf
docker/cad/requirements.txt text eol=lf

# The prebuilt runtime index is shared by POSIX and Windows launchers.
docker/prebuilt-images.tsv text eol=lf

# Keep the pinned upstream JSON header byte-identical across Windows checkouts.
native/windows-launcher/third_party/json.hpp -text
native/windows-launcher/third_party/LICENSE.json -text whitespace=-blank-at-eol
native/windows-launcher/third_party/miniz/miniz_tinfl.c -text
native/windows-launcher/third_party/miniz/miniz_tinfl.h -text
native/windows-launcher/third_party/miniz/miniz_common.h -text
native/windows-launcher/third_party/miniz/LICENSE -text whitespace=cr-at-eol

# CMD entrypoints need stable Windows line endings even in Git source checkouts.
*.bat text eol=crlf
