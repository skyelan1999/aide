# Preserve official vendored bytes, including license comment line endings.
internal/server/web/vendor/markdown-export/jspdf.umd.min.js whitespace=-blank-at-eol

# TypeScript is authoritative; do not count its checked-in runtime output twice.
internal/server/web/*.js linguist-generated=true
internal/server/web/locales/*.js linguist-generated=true
scripts/computer-bridge.js linguist-generated=true
scripts/computer-bridge-linux.js linguist-generated=true
scripts/headless-browser-bridge.js linguist-generated=true
scripts/safari-bridge.js linguist-generated=true
scripts/codex-host-control.cjs linguist-generated=true
scripts/fixtures/marked-resource-probes.js linguist-generated=true
scripts/lock-cluster-election.test.js linguist-generated=true
scripts/lock-cluster-state.test.js linguist-generated=true
scripts/markdown-download-export.test.js linguist-generated=true
scripts/markdown-image-path.test.js linguist-generated=true
examples/file-preview-plugin/index.js linguist-generated=true
internal/server/plugin_host.js linguist-generated=true
internal/server/code_analysis/javascript.cjs linguist-generated=true
internal/server/mixsoul/*.cjs linguist-generated=true
internal/server/testdata/provider-support/*/index.js linguist-generated=true
plugins/testdata/mock-daemon/index.js linguist-generated=true
site/main.js linguist-generated=true
# Preserve original OCCT license bytes and generated STEP exchange formatting.
scripts/cad/licenses/OCCT-LGPL-2.1.txt whitespace=-blank-at-eol
scripts/fixtures/cad/fidelity.step whitespace=-blank-at-eol

# Linux container entry points must survive Windows core.autocrlf checkouts.
*.sh text eol=lf
*.command text eol=lf
docker/cad/requirements.txt text eol=lf

# The prebuilt runtime index is shared by POSIX and Windows launchers.
docker/prebuilt-images.tsv text eol=lf

# Keep the pinned upstream JSON header byte-identical across Windows checkouts.
native/windows-launcher/third_party/json.hpp -text
native/windows-launcher/third_party/LICENSE.json -text whitespace=-blank-at-eol
native/windows-launcher/third_party/miniz/miniz_tinfl.c -text
native/windows-launcher/third_party/miniz/miniz_tinfl.h -text
native/windows-launcher/third_party/miniz/miniz_common.h -text
native/windows-launcher/third_party/miniz/LICENSE -text whitespace=cr-at-eol

# CMD entrypoints need stable Windows line endings even in Git source checkouts.
*.bat text eol=crlf

# Keep Python/Node helpers and container build inputs LF on Windows checkouts.
# Directly executed shebang scripts otherwise fail with "python3\r: not found".
*.py text eol=lf
*.cjs text eol=lf
Dockerfile* text eol=lf

# Hash-pinned third-party sources must retain their original bytes (#811, #837).
legal/third_party/** -text
internal/server/web/vendor/** -text
# Generated PlantUML prefix includes this first-party source verbatim.
internal/server/web/plantuml-resource-helpers.js text eol=lf

# Keep embedded parser notices byte-identical across host checkouts.
internal/server/code_analysis/*-LICENSE -text
scripts/fixtures/PDFIUM-LICENSE -text

# Source patches are checksum-pinned build inputs.
scripts/openjpeg/*-fixes.patch -text -whitespace

scripts/host-bridge-vendor.patch -text -whitespace

# Preserve original pinned bridge dependency sources and upstream notices.
vendor/github.com/go-git/** -text -whitespace
vendor/github.com/hashicorp/** -text -whitespace
vendor/github.com/rasky/** -text -whitespace
vendor/github.com/willscott/** -text -whitespace

# Preserve checksum-pinned CAD patches and PDF resource license bytes.
docker/libredwg/*.patch -text -whitespace
internal/server/web/vendor/pdfjs/cmaps/LICENSE -whitespace
internal/server/web/vendor/pdfjs/standard_fonts/LICENSE* -whitespace
legal/third_party/npm/pdfjs-dist-resources/LICENSE* -whitespace

# Preserve pinned LibreCAD stroke font sources and their upstream notices.
docker/cad-fonts/* -text -whitespace
