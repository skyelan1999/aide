{
  "version": 1,
  "workflow": "docs/agent/WORKFLOW.md",
  "skill_router": {
    "entry": ".agents/skills/aide-development-router/SKILL.md",
    "max_specialists": 3,
    "fallback": "coordinator",
    "routes": [
      {
        "id": "backend",
        "title": "Go 后端与产品能力",
        "skill": ".agents/skills/aide-backend/SKILL.md",
        "priority": 10,
        "keywords": [
          "后端",
          "go",
          "api",
          "接口",
          "会话",
          "工作流",
          "provider",
          "模型调用",
          "存储",
          "插件",
          "mcp",
          "任务状态"
        ],
        "source_roots": [
          "cmd/aide",
          "internal/server"
        ],
        "verification": [
          "选择对应 Go 包的单测",
          "按需执行 scripts/agent-route.py verify quick"
        ]
      },
      {
        "id": "frontend",
        "title": "网页界面与交互",
        "skill": ".agents/skills/aide-frontend/SKILL.md",
        "priority": 20,
        "keywords": [
          "前端",
          "网页",
          "界面",
          "ui",
          "css",
          "样式",
          "设置页",
          "按钮",
          "对话框",
          "渲染",
          "i18n",
          "国际化",
          "无障碍",
          "浏览器"
        ],
        "source_roots": [
          "internal/server/web"
        ],
        "verification": [
          "执行变更相关的 node 检查或脚本",
          "UI 改动须在真实浏览器验收"
        ]
      },
      {
        "id": "runtime-release",
        "title": "启动、容器与发行升级",
        "skill": ".agents/skills/aide-runtime-release/SKILL.md",
        "priority": 30,
        "keywords": [
          "docker",
          "容器",
          "镜像",
          "release",
          "发行",
          "发布",
          "安装",
          "启动",
          "端口",
          "升级",
          "a/b",
          "macos",
          "windows",
          "ubuntu",
          "打包",
          "脚本"
        ],
        "source_roots": [
          "Dockerfile",
          "compose.yaml",
          "scripts",
          "docker-images",
          "docs/architecture/software-updates.md"
        ],
        "verification": [
          "bash -n 检查涉及的 shell 脚本",
          "仅按用户授权执行构建、发布或推送"
        ]
      },
      {
        "id": "security",
        "title": "鉴权、权限与敏感数据",
        "skill": ".agents/skills/aide-security/SKILL.md",
        "priority": 40,
        "keywords": [
          "安全",
          "鉴权",
          "认证",
          "权限",
          "令牌",
          "token",
          "密钥",
          "secret",
          "vault",
          "路径穿越",
          "注入",
          "加密",
          "csrf",
          "csp"
        ],
        "source_roots": [
          "internal/server",
          "internal/server/web",
          "docs/security"
        ],
        "verification": [
          "覆盖拒绝路径和未授权路径的相关回归",
          "不输出真实密钥、令牌或用户数据"
        ]
      },
      {
        "id": "verification-docs",
        "title": "验证、文档与交接",
        "skill": ".agents/skills/aide-verification-docs/SKILL.md",
        "priority": 50,
        "keywords": [
          "测试",
          "验收",
          "验证",
          "文档",
          "说明",
          "交接",
          "qa",
          "回归",
          "bug",
          "问题",
          "复现",
          "报告"
        ],
        "source_roots": [
          "scripts",
          "docs/agent",
          "docs/tasks",
          "docs/reviews"
        ],
        "verification": [
          "记录实际执行的命令和结果",
          "运行 python3 scripts/check_docs.py 检查文档链接"
        ]
      }
    ]
  },
  "stages": [
    "requirements",
    "design",
    "implementation",
    "verification",
    "documentation",
    "cleanup",
    "release"
  ],
  "clients": {
    "codex": {
      "entry": "AGENTS.md",
      "mode": "native-project-instructions"
    },
    "claude": {
      "entry": "CLAUDE.md",
      "mode": "native-project-instructions-or-manual"
    },
    "deepseek": {
      "entry": "AGENTS.md",
      "mode": "dsh-project-instructions-or-manual"
    },
    "doubao": {
      "entry": "AGENTS.md",
      "mode": "manual-bootstrap"
    },
    "workbuddy": {
      "entry": "CODEBUDDY.md",
      "mode": "client-handshake-required"
    }
  },
  "checks": {
    "quick": [
      [
        "git",
        "diff",
        "--check"
      ],
      [
        "node",
        "--check",
        "internal/server/web/app.js"
      ],
      [
        "node",
        "scripts/test_reminder_styles.cjs"
      ],
      [
        "node",
        "scripts/test_approval_persistence.cjs"
      ],
      [
        "node",
        "--check",
        "internal/server/web/settings-init.js"
      ],
      [
        "bash",
        "scripts/version.sh",
        "check"
      ],
      [
        "python3",
        "scripts/test_agent_route.py"
      ],
      [
        "python3",
        "scripts/check_docs.py"
      ],
      [
        "bash",
        "-n",
        "scripts/install.sh"
      ],
      [
        "bash",
        "-n",
        "scripts/aide.sh"
      ],
      [
        "python3",
        "scripts/test_install.py"
      ],
      [
        "node",
        "--check",
        "internal/server/web/i18n.js"
      ],
      [
        "node",
        "--check",
        "internal/server/web/locales/en.js"
      ],
      [
        "node",
        "scripts/test_i18n.cjs"
      ],
      [
        "node",
        "scripts/test_stream_url.cjs"
      ],
      [
        "node",
        "scripts/test_accessibility_port.cjs"
      ],
      [
        "python3",
        "scripts/test_windows_port_lifecycle.py"
      ],
      [
        "python3",
        "scripts/test_local_root.py"
      ],
      [
        "python3",
        "scripts/test_control_bridge_launchers.py"
      ],
      [
        "node",
        "scripts/test_ui_click_latency.cjs"
      ],
      [
        "node",
        "scripts/markdown-image-path.test.js"
      ],
      [
        "node",
        "scripts/markdown-download-export.test.js"
      ],
      [
        "node",
        "scripts/starmap-infrared.test.cjs"
      ],
      [
        "node",
        "scripts/starmap-path.test.cjs"
      ],
      [
        "node",
        "scripts/starmap-timeline.test.cjs"
      ],
      [
        "node",
        "scripts/markdown-live-preview.test.cjs"
      ],
      [
        "node",
        "scripts/markdown-history-writable.test.cjs"
      ],
      [
        "node",
        "scripts/starmap-document-continuation.test.cjs"
      ],
      [
        "node",
        "scripts/starmap-workspace-scene.test.cjs"
      ],
      [
        "node",
        "scripts/starmap-coverage-state.test.cjs"
      ],
      [
        "node",
        "scripts/toast-lifecycle.test.cjs"
      ],
      [
        "node",
        "scripts/lock-entry.test.cjs"
      ],
      [
        "node",
        "scripts/file-recovery-scroll.test.cjs"
      ],
      [
        "node",
        "scripts/continuity-isolation.test.cjs"
      ],
      [
        "node",
        "scripts/workspace-scene-transition.test.cjs"
      ]
    ],
    "full": [
      [
        "bash",
        "scripts/aide.sh",
        "test"
      ]
    ]
  },
  "required_files": [
    "AGENTS.md",
    "CLAUDE.md",
    "CODEBUDDY.md",
    "docs/agent/WORKFLOW.md",
    "docs/agent/ADAPTERS.md",
    "scripts/agent-route.py",
    "scripts/test_agent_route.py",
    "docs/README.md",
    "scripts/check_docs.py"
  ],
  "cleanup": {
    "automatic_delete_basename": ".DS_Store",
    "protected_roots": [
      ".git",
      ".data",
      ".cache",
      ".idea",
      ".workbuddy",
      ".agent-state",
      "docker-images",
      "test-results"
    ]
  }
}
