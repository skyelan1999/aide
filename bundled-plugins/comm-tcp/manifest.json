{
  "id": "comm-tcp",
  "name": "TCP 通讯",
  "description": "基于 Node 内置 net 模块的常驻 TCP 通讯插件：监听/连接/收发、本地代理录制、规则模拟应答、录制回放与 fuzz；零第三方依赖，默认禁用，仅绑回环 127.0.0.1",
  "version": "1.0.0",
  "author": "aide",
  "main": "index.js",
  "daemon": true,
  "enabled": false,
  "tools": [
    { "name": "tcp_listen", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_connect", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_send", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_close", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_proxy_start", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_proxy_stop", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_simulate_set", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_simulate_clear", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_replay", "kind": "write", "readonlyDefault": false },
    { "name": "tcp_fuzz", "kind": "write", "readonlyDefault": false }
  ],
  "settingsSchema":   {
    "type": "object",
    "title": "插件参数",
    "description": "此插件暂未声明专属选项。可在扩展参数中添加插件会读取的设置，也可切换到文本模式直接编辑 JSON。",
    "properties": {},
    "additionalProperties": true
  }
}
